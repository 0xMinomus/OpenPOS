{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPOS Lite",
  "version": "0.1.0",
  "identifier": "com.openpos.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/offline-lite.html",
    "beforeBuildCommand": "npm run build:lite",
    "frontendDist": "../dist-lite"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenPOS Lite",
        "url": "offline-lite.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "111.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
